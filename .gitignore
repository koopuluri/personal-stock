# Keep local dotfiles off GitHub. The three exceptions are repository metadata that
# collaborators need for line endings, ignore rules, and the Foundry submodule.
.*
!/.gitattributes
!/.gitignore
!/.gitmodules

# Local tools and editor state
.DS_Store
.claude/
.idea/
.obsidian/
.vscode/
CLAUDE.md
*.code-workspace
*.swp
*.swo
*~

# Environment files and secrets — never commit
.env
.env.*
*.env
*.env.*
*.key
*.pem
*.p12
*.pfx
*.keystore
*.json.keystore
keystore/
keystores/
mnemonic.txt
private-key.txt
*private-key*
*private_key*
*mnemonic*
*seed-phrase*
*seed_phrase*
secrets.*

# Foundry-generated files
out/
cache/
broadcast/

# Python-generated files and local environments
__pycache__/
*.py[cod]
.coverage
.pytest_cache/
.venv/
htmlcov/
venv/

# Logs and temporary files
*.log
*.tmp

# Unpublished append drafts stay local until their transaction succeeds.
/next.batch.json
