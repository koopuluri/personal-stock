# Copy to ledger/.env. Never commit ledger/.env. Signing uses an encrypted
# Foundry keystore account; no private key belongs in this file.

BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# Created with: cast wallet import <name> --interactive
ACCOUNT=

# Deployment
STOCK_NAME=Karthik Uppuluri Stock
# Prefer a multisig or account with a documented succession/recovery process.
CONTROLLER=

# Publication. These may instead be passed to publish.sh.
LEDGER_ADDRESS=
BATCH_PATH=
NETWORK=base_sepolia

# Optional destination for exact source batches and transaction receipts.
# PUBLISHED_DIR=documents/published/events
