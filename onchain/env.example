# Copy to onchain/.env. Never commit onchain/.env. There are no private keys here
# by design — signing uses an encrypted Foundry keystore account (see ACCOUNT below).

# --- RPC ---
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Verification ---
# Etherscan/Basescan API key. Without verification the "Read Contract" tab does not
# work, which defeats the point of storing content onchain.
BASESCAN_API_KEY=

# --- Signing ---
# Name of the encrypted keystore account created with:
#   cast wallet import <name> --interactive
# Foundry prompts for its password; the key never touches this file.
ACCOUNT=

# --- Publishing (read by onchain/script/Publish.s.sol) ---
# Set per publish, or pass as arguments to onchain/script/publish.sh.
DOC_ADDRESS=
DOC_PATH=documents/stock.md

# Optional: where publish.sh writes snapshots. Relative paths start at the repository
# root. The default is documents/published/.
# Point it elsewhere for throwaway testnet publishes.
# PUBLISHED_DIR=documents/published
